# ============================================================
# CARTICOM — Environment Configuration
# ============================================================

# ─── Backend API ─────────────────────────────────────────────
# Backend URL used server-side (Next.js API routes proxying).
# NOTE: do NOT include /api/v1 here — it is appended via BACKEND_API_PREFIX.
BACKEND_URL=http://localhost:8080
BACKEND_API_PREFIX=/api/v1

# ─── Next.js Public Config ──────────────────────────────────
# These are exposed to the browser — NEVER put secrets here
# Live domain (deployed on Vercel). For local development use http://localhost:3000
NEXT_PUBLIC_APP_URL=https://carticom.vercel.app
# Full API base consumed by the browser (lib/axios.ts). Do NOT append /api/v1:
# every service path ALREADY starts with /api/v1 (e.g. /api/v1/auth/login),
# so adding the prefix here produces the broken /api/v1/api/v1 with the backend paths.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Authentication ─────────────────────────────────────────
# Session timeout in milliseconds (30 minutes)
NEXT_PUBLIC_SESSION_TIMEOUT=1800000
# OAuth: public callback URL (must match the authorized redirect URI
# registered for the Google OAuth client)
# NEXT_PUBLIC_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─── Feature Flags ──────────────────────────────────────────
# WARNING: escrow and analytics are NOT production-ready. Keep them false.
NEXT_PUBLIC_ENABLE_ESCROW=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Page views are only
# tracked when NEXT_PUBLIC_ENABLE_ANALYTICS=true and this is set.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Development ────────────────────────────────────────────
NODE_ENV=development

# ─── Monitoring (Sentry) ─────────────────────────────────
# https://sentry.io/settings/{org}/projects/{project}/keys/
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ─── Deployment (Render backend + Vercel frontend) ──────────
# Production example (set in Vercel, never in git):
# NEXT_PUBLIC_APP_URL=https://carticom.vercel.app
# NEXT_PUBLIC_API_URL=https://backend-kqel.onrender.com